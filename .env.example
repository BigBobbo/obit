# --- App ---
# Canonical origin of the deployed app (used for QR codes, links in emails, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (DB + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only. Used by the moderation pipeline, cron jobs and admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (bot defense) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Claude API (Tier 1 text moderation) ---
ANTHROPIC_API_KEY=

# --- Sightengine (Tier 0 image moderation) ---
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM="Memorial Pages <no-reply@example.com>"

# --- Stripe (freemium billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the single paid tier
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# --- Contributor cookie ---
# HMAC key for the signed "returning contributor" cookie, which lets a verified
# contributor skip email verification on later submissions. REQUIRED in
# production — the app refuses to sign or verify the cookie without it.
#   openssl rand -base64 32
CONTRIBUTOR_COOKIE_SECRET=

# --- Public contact addresses ---
# Shown in the Terms/Privacy pages. Both default to support@/dmca@ your app's
# own domain (from NEXT_PUBLIC_APP_URL); set them only if the mailboxes live
# elsewhere. The DMCA address must be a real, monitored mailbox.
SUPPORT_EMAIL=
DMCA_AGENT_EMAIL=

# --- Cron (Vercel cron auth) ---
CRON_SECRET=

# --- Private beta ---
# Comma-separated invite codes required at signup. Leave empty to open signups.
BETA_INVITE_CODES=
