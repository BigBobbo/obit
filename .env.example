# --- App ---
# Canonical origin of the deployed app (used for QR codes, links in emails, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (DB + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only. Used by the moderation pipeline, cron jobs and admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (bot defense) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Claude API (Tier 1 text moderation) ---
ANTHROPIC_API_KEY=

# --- Sightengine (Tier 0 image moderation) ---
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM="Memorial Pages <no-reply@example.com>"

# --- Stripe (freemium billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the single paid tier
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# --- Contributor cookie ---
# HMAC key for the signed "returning contributor" cookie, which lets a verified
# contributor skip email verification on later submissions. REQUIRED in
# production — the app refuses to sign or verify the cookie without it.
#   openssl rand -base64 32
CONTRIBUTOR_COOKIE_SECRET=

# --- Public contact addresses ---
# Shown in the Terms/Privacy pages. Both default to support@/dmca@ your app's
# own domain (from NEXT_PUBLIC_APP_URL); set them only if the mailboxes live
# elsewhere. The DMCA address must be a real, monitored mailbox.
SUPPORT_EMAIL=
DMCA_AGENT_EMAIL=

# --- Cron (Vercel cron auth) ---
CRON_SECRET=

# --- Charity giving (PRD v2 §3) ---
# Giving is OFF unless a partner is configured, and the launch checklist in
# docs/giving-compliance.md must be complete before it is turned on.
# We never hold funds: the donate button redirects to the partner's own
# checkout, and the webhook below records the confirmation that comes back.
GIVING_PARTNER=everydotorg
# Public partner API key (nonprofit search + donate links).
EVERY_ORG_API_KEY=
# A secret you generate. It goes on the checkout link and authenticates the
# confirmation webhook: openssl rand -hex 32
EVERY_ORG_WEBHOOK_TOKEN=

# --- Free-for-now (PRD v2 §2.4) ---
# Pricing is deferred while the product is funded. Set to 1 and every account
# gets the paid limits; the plan fences and Stripe routes stay in the code, so
# returning to pricing is a config change rather than a rebuild.
ALL_FEATURES_FREE=1

# --- Private beta ---
# Comma-separated invite codes required at signup. Leave empty to open signups.
BETA_INVITE_CODES=
